SECRET_API_KEY=change-me-admin-api-key
DATABASE_URL=host=127.0.0.1 user=relay password=relay_dev dbname=relay port=5432 sslmode=disable TimeZone=UTC
RELAY_ENROLLMENT_TOKEN=local-dev-enrollment-token
TLS_CLIENT_AUTH=require
RELAY_DEBUG_USERNAME=
RELAY_DEBUG_PASSWORD=
RELAY_GRPC_CERT_FILE=certs/server.crt
RELAY_GRPC_KEY_FILE=certs/server.key
RELAY_ADMIN_CERT_FILE=certs/admin.crt
RELAY_ADMIN_KEY_FILE=certs/admin.key
RELAY_DEVICE_CA_CERT_FILE=certs/ca.crt
RELAY_DEVICE_CA_KEY_FILE=certs/ca.key
RELAY_GOAWAY_SHUTDOWN_DRAIN_MS=5000
RELAY_SHUTDOWN_TIMEOUT_SECONDS=15
RELAY_DNS_CHALLENGE_TTL_SECONDS=86400
RELAY_DNS_INSTRUCTION_TTL_SECONDS=300
RELAY_DNS_VERIFY_MIN_INTERVAL_SECONDS=60
RELAY_DNS_VERIFY_INITIAL_INTERVAL_SECONDS=30
RELAY_DNS_VERIFY_MAX_INTERVAL_SECONDS=900
RELAY_DNS_VERIFY_JITTER_PERCENT=10
RELAY_DNS_VERIFY_WORKER_INTERVAL_SECONDS=5
RELAY_DNS_VERIFY_WORKER_BATCH_SIZE=32
RELAY_DNS_VERIFY_WORKER_CONCURRENCY=8
RELAY_DNS_VERIFY_CLAIM_LEASE_SECONDS=30
RELAY_DNS_VERIFY_LOOKUP_TIMEOUT_SECONDS=5
RELAY_MAX_ACTIVE_DNS_CHALLENGES_PER_DEVICE=32
